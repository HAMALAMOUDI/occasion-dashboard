# Copy to .env.local and fill in. With the WhatsApp values left empty, all
# sends are logged to the console (demo mode).

# --- Database ---
# Set automatically on Vercel by the Neon integration. Leave empty locally to
# use data/store.json instead.
DATABASE_URL=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=            # verifies webhook signatures (X-Hub-Signature-256)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=  # any string; enter the same value in the Meta webhook config
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=en          # language code of the English template versions
WHATSAPP_TEMPLATE_LANG_AR=ar       # language code of the Arabic template versions
WHATSAPP_INVITE_TEMPLATE=occasion_invite
WHATSAPP_ANNOUNCE_TEMPLATE=occasion_announcement   # condolences: no reply buttons
WHATSAPP_REMINDER_TEMPLATE=occasion_reminder

# --- Organizer sign-in ---
ADMIN_PHONES=                   # comma-separated numbers that see ALL events (incl. ones created before sign-in)
WHATSAPP_LOGIN_TEMPLATE=occasion_login_code
AUTH_DEMO_CODES=                # "false" stops showing sign-in codes on screen while WhatsApp isn't connected

# --- Scheduling ---
CRON_SECRET=                    # required in production for /api/cron/reminders
EVENT_TIMEZONE=Asia/Riyadh      # "today" for reminder scheduling

# --- Guests & billing ---
DEFAULT_COUNTRY_CODE=966        # applied to local numbers like 05XXXXXXXX
RATE_PER_CONVERSATION_SAR=0.35
